TZ=Europe/Moscow
SERVER_HOST=https://monitoring.example.com/
AGENT_KEY_HASH=
# AGENT_VERSION=
REPORT_INTERVAL_SEC=30
DEBUG=false
COLLECT_DOCKER=true
COLLECT_PROXMOX=true
COLLECT_AUTH=true
COLLECT_PROCESSES=true
COLLECT_LISTENERS=true
PROCESS_TOP_N=20
# Pull newer binary from GitHub when the monitoring server requests it
AUTO_UPDATE=true
# Only accept update URLs under github.com/AKEB/monitoring-agent/releases/download/
UPDATE_FROM_GITHUB=true
